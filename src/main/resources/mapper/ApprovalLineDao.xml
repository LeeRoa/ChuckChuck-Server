<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="rise.cc.dao.ApprovalLineDao">
    <insert id="createApprovalLineList" parameterType="list">
        INSERT INTO APPRO_LINE
            (
             LINE_TYPE,
             DOC_NO,
             EMP_ID,
             APPRO_SEQ
             )
        VALUES
        <foreach collection="list" item="liner" index="index" separator=",">
            (
             #{liner.lineType},
             #{liner.docNo},
             #{liner.empId},
             #{index + 1}
            )
        </foreach>
    </insert>
    <update id="updateApprovalLine" parameterType="rise.cc.dto.ApprovalLiner">

    </update>
    <update id="deleteApprovalLine" parameterType="rise.cc.dto.ApprovalLiner">

    </update>
    <select id="getApprovalLine" parameterType="rise.cc.dto.ApprovalLiner">

    </select>
</mapper>
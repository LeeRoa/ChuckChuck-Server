<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="rise.cc.dao.ScheduleDao">
    <insert id="createScheduleGroup" parameterType="rise.cc.dto.ScheduleGroup">
        INSERT INTO
            SCHEDULE_GROUP
            (
            SCHEDULE_GROUP_NAME,
            SCHEDULE_GROUP_DESCRIPTION,
            EMP_ID
            )
        VALUES
            (
            #{scheduleGroupName},
            #{scheduleGroupDescription},
            #{empId}
            )
    </insert>

</mapper>
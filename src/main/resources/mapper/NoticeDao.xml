<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="rise.cc.dao.NoticeDao">
    <insert id="insertNotice" useGeneratedKeys="true" keyProperty="notice.docId">
        insert into CC_NOTICE (NOTICE_TITLE,
                               NOTICE_CONTENT,
                               COMMENT_YN,
                               CREATE_DT,
                               UPDATE_DT,
                               NOTIFICATION_YN,
                               DELETE_YN,
                               VIEW_COUNT,
                               EMP_ID)
        values (#{notice.noticeTitle},
                #{notice.noticeContent},
                #{notice.commentYn},
                #{notice.createDt},
                #{notice.updateDt},
                #{notice.notificationYn},
                'N',
                0,
                #{notice.empId})
    </insert>

    <insert id="insertFile" useGeneratedKeys="true" keyProperty="notice.fileNo">
        insert into CC_FILES (ORIGIN_NAME,
                              STORED_NAME,
                              CREATE_DT,
                              UPDATE_DT,
                              FILE_SIZE,
                              FILE_PATH,
                              FILE_CONTENT)
        values (#{notice.originName},
                #{notice.storedName},
                #{notice.createDt},
                #{notice.updateDt},
                #{notice.fileSize},
                #{notice.filePath},
                #{notice.fileContent})
    </insert>

    <insert id="insertFileType">
        insert into FILES_TYPE (FILE_NO, TYPE_INFO, DOC_ID)
        values (#{fileNo}, 'B', #{docId})
    </insert>


<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="rise.cc.dao.NoticeDao">
    <insert id="insertNotice" useGeneratedKeys="true" keyProperty="noticeNo"
            parameterType="rise.cc.dto.Notice">
        insert into CC_NOTICE (NOTICE_TITLE,
                               NOTICE_CONTENT,
                               COMMENT_YN,
                               CREATE_DT,
                               UPDATE_DT,
                               NOTIFICATION_YN,
                               DELETE_YN,
                               VIEW_COUNT,
                               EMP_ID)
        values (#{noticeTitle},
                #{noticeContent},
                #{commentYn},
                #{createDt},
                NULL,
                #{notificationYn},
                'N',
                0,
                #{empId})
    </insert>

    <insert id="insertFile" useGeneratedKeys="true" keyProperty="fileNo"
            parameterType="rise.cc.dto.File">
        insert into CC_FILES (ORIGIN_NAME,
                              STORED_NAME,
                              CREATE_DT,
                              UPDATE_DT,
                              FILE_SIZE,
                              FILE_PATH,
                              FILE_CONTENT)
        values (#{originName},
                #{storedName},
                #{createDt},
                NULL,
                #{fileSize},
                #{filePath},
                #{fileContent})
    </insert>

    <insert id="insertFileType" useGeneratedKeys="true" keyProperty="typeId"
            parameterType="rise.cc.dto.FilesType">
        insert into FILES_TYPE (FILE_NO, TYPE_INFO, DOC_ID)
        values (#{fileNo}, 'B', #{docId})
    </insert>
</mapper>
